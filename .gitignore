# 数据集与模型权重一律不入库，只保留各目录下的 README
data/*
!data/README.md
models/*
!models/README.md
logs/

# 常见音频与权重格式，防止误提交
*.wav
*.flac
*.mp3
*.m4a
*.ogg
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
*.onnx

# 压缩包与临时下载
*.zip
*.tar
*.tar.gz
*.tgz
*.part
*.tmp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 运行产物
*.log
nohup.out

# ---- 实验侧补充（2026-10-07）----
# 第三方仓库副本（276MB，含其上游客的模型文件），不入库，来源见 docs/实验侧环境.md
code/voiceclone/

# 本机私有环境覆盖（含本机 conda 路径），不入库
scripts/env.local.sh

# ---- 网页演示站（2026-10-19）----
# 站点运行期产物与本机配置（app/.gitignore 另有一份局部规则）
app/data/
app/logs/
app/config.json
# 合成部署包里的权重与中文注音模型，按"权重不入库"的政策排除
deploy/synthesis/GPT-SoVITS/GPT_SoVITS/pretrained_models/
deploy/synthesis/GPT-SoVITS/GPT_SoVITS/text/G2PWModel/g2pW.onnx

# data/ 例外：manifest、下载脚本、校验和按约定入库（data/README.md 的口径）
!data/manifests/
!data/*.sh
!data/*.py
!data/dataset_audit.csv
!data/split_check.txt

# ---- 合成部署包的运行时缓存与大体积语言资源（2026-10-19）----
# engdict_cache.pickle 是 GPT-SoVITS 首次运行时生成的英文 g2p 缓存，不是源码
deploy/synthesis/GPT-SoVITS/GPT_SoVITS/text/engdict_cache.pickle
# 日文用户词典 16MB，本演示只走中文，需要日文时从上游 GPT-SoVITS 取
deploy/synthesis/GPT-SoVITS/GPT_SoVITS/text/ja_userdic/userdict.csv
