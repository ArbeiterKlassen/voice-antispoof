# 数据集与模型权重一律不入库，只保留各目录下的 README
data/*
!data/README.md
models/*
!models/README.md
logs/

# 常见音频与权重格式，防止误提交
*.wav
*.flac
*.mp3
*.m4a
*.ogg
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
*.onnx

# 压缩包与临时下载
*.zip
*.tar
*.tar.gz
*.tgz
*.part
*.tmp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 运行产物
*.log
nohup.out

# ---- 实验侧补充（2026-10-07）----
# 第三方仓库副本（276MB，含其上游客的模型文件），不入库，来源见 docs/实验侧环境.md
code/voiceclone/

# 本机私有环境覆盖（含本机 conda 路径），不入库
scripts/env.local.sh

# data/ 例外：manifest、下载脚本、校验和按约定入库（data/README.md 的口径）
!data/manifests/
!data/*.sh
!data/*.py
!data/dataset_audit.csv
!data/split_check.txt
